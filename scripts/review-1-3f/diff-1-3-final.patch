+        schemes: row.schemes as string[],
+        status: status as ConnectionInfo['status'],
+        verified_at: (row.verified_at as string | null) ?? null,
+        client_id: (row.client_id as string | null) ?? null,
+        rights: row.rights as RightsCheck[],
