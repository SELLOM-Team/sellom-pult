+    /// касаться БД).
+    fn state_with(probe: Arc<dyn RightsProbe>) -> AppState {
+        let db = sqlx::postgres::PgPoolOptions::new()
+            .connect_lazy("postgres://vault-test:stub@127.0.0.1:1/vault-test")
